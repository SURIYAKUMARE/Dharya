// =======================================================================
// ALGOTUTOR LMS PRISMA DATABASE SCHEMA (POSTGRESQL)
// Supports Students, Faculty, Admins, Analytics, Submissions & Leaderboards
// =======================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum SubmissionStatus {
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT_EXCEEDED
  COMPILATION_ERROR
  PENDING
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ProjectStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum StatusType {
  PHOTO
  VIDEO
  TEXT
  AUDIO
}

enum PrivacyType {
  CONTACTS
  EXCEPT
  ONLY
  PRIVATE
}

// 1. Users Model
model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  passwordHash        String
  name                String
  studentId           String?            @unique
  role                Role               @default(STUDENT)
  avatarUrl           String?
  batch               String?
  totalPoints         Int                @default(8019)
  rank                Int                @default(54)
  readReceiptsEnabled Boolean            @default(true)
  privacySettings     Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  enrollments         Enrollment[]
  attendances         Attendance[]
  submissions         CodingSubmission[]
  quizAttempts        QuizAttempt[]
  projectSubs         Project[]
  rewards             Reward[]
  leaderboard         LeaderboardScore?
  notifications       Notification[]

  // Status & Contacts Relations
  statuses            Status[]
  statusViews         StatusView[]
  statusRepliesSent   StatusReply[]      @relation("StatusSender")
  statusRepliesRecv   StatusReply[]      @relation("StatusReceiver")
  contacts            Contact[]          @relation("UserContacts")
  contactOf           Contact[]          @relation("ContactUser")

  @@map("users")
}

// 2. Courses Model
model Course {
  id              String        @id @default(uuid())
  code            String        @unique
  title           String
  description     String
  instructorName  String
  category        String
  thumbnailUrl    String?
  totalLessons    Int           @default(45)
  totalHours      Float         @default(32.5)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  enrollments     Enrollment[]

  @@map("courses")
}

// 3. Course Enrollments
model Enrollment {
  id              String        @id @default(uuid())
  userId          String
  courseId        String
  progressPct     Int           @default(0)
  completedLessons Int          @default(0)
  enrolledAt      DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  course          Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("enrollments")
}

// 4. Attendance Records
model Attendance {
  id              String           @id @default(uuid())
  userId          String
  date            DateTime
  sessionName     String
  status          AttendanceStatus @default(PRESENT)
  remarks         String?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("attendances")
}

// 5. Coding Problems Model
model CodingProblem {
  id              String           @id @default(uuid())
  title           String
  slug            String           @unique
  difficulty      Difficulty       @default(EASY)
  category        String
  tags            String[]
  description     String
  constraints     String[]
  starterCode     Json             // { "python": "...", "cpp": "..." }
  testCases       Json             // [ { "input": "...", "output": "..." } ]
  points          Int              @default(50)
  isProblemOfDay  Boolean          @default(false)
  acceptanceRate  Float            @default(74.5)
  createdAt       DateTime         @default(now())

  submissions     CodingSubmission[]

  @@map("coding_problems")
}

// 6. Coding Submissions
model CodingSubmission {
  id              String           @id @default(uuid())
  userId          String
  problemId       String
  language        String
  code            String
  status          SubmissionStatus @default(ACCEPTED)
  runtimeMs       Int?
  memoryKb        Int?
  submittedAt     DateTime         @default(now())

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem         CodingProblem    @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@map("coding_submissions")
}

// 7. MCQ Questions
model McqQuestion {
  id              String        @id @default(uuid())
  question        String
  options         String[]
  correctIndex    Int
  explanation     String
  category        String
  difficulty      Difficulty    @default(EASY)

  quizAttempts    QuizAttemptDetail[]

  @@map("mcq_questions")
}

// 8. Quiz Attempts
model QuizAttempt {
  id              String        @id @default(uuid())
  userId          String
  totalQuestions  Int
  correctCount    Int
  scorePct        Float
  timeTakenSec    Int
  completedAt     DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  details         QuizAttemptDetail[]

  @@map("quiz_attempts")
}

model QuizAttemptDetail {
  id              String        @id @default(uuid())
  attemptId       String
  questionId      String
  selectedOption  Int
  isCorrect       Boolean

  attempt         QuizAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        McqQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("quiz_attempt_details")
}

// 9. Assessments
model Assessment {
  id              String        @id @default(uuid())
  title           String
  subject         String
  totalMarks      Int           @default(100)
  durationMins    Int           @default(60)
  passingPct      Float         @default(50.0)
  createdAt       DateTime      @default(now())

  @@map("assessments")
}

// 10. Student Capstone Projects
model Project {
  id              String        @id @default(uuid())
  userId          String
  title           String
  description     String
  techStack       String[]
  githubUrl       String?
  liveUrl         String?
  status          ProjectStatus @default(PENDING)
  mentorFeedback  String?
  grade           String?
  submittedAt     DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("projects")
}

// 11. Student Rewards & Badges
model Reward {
  id              String        @id @default(uuid())
  userId          String
  badgeName       String
  badgeIcon       String
  description     String
  pointsAwarded   Int           @default(100)
  awardedAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("rewards")
}

// 12. Leaderboard Scores
model LeaderboardScore {
  id              String        @id @default(uuid())
  userId          String        @unique
  points          Int           @default(0)
  rank            Int           @default(1)
  problemsSolved  Int           @default(0)
  streakDays      Int           @default(0)
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("leaderboard_scores")
}

// 13. Notifications
model Notification {
  id              String        @id @default(uuid())
  userId          String
  title           String
  message         String
  type            String        @default("INFO")
  isRead          Boolean       @default(false)
  createdAt       DateTime      @default(now())

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// 14. Contact Model
model Contact {
  id                  String       @id @default(uuid())
  userId              String
  contactUserId       String
  relationshipStatus  String       @default("FRIEND")
  createdAt           DateTime     @default(now())

  user                User         @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contactUser         User         @relation("ContactUser", fields: [contactUserId], references: [id], onDelete: Cascade)

  @@unique([userId, contactUserId])
  @@map("contacts")
}

// 15. Statuses Model (WhatsApp-style 24h temporary updates)
model Status {
  id                  String       @id @default(uuid())
  userId              String
  type                StatusType   @default(PHOTO)
  mediaUrl            String?
  thumbnailUrl        String?
  audioUrl            String?
  songTitle           String?
  songArtist          String?
  textContent         String?
  caption             String?
  backgroundColor     String?
  fontFamily          String?
  filter              String?
  drawingDataUrl      String?
  privacy             PrivacyType  @default(CONTACTS)
  excludedContacts    String[]     @default([])
  includedContacts    String[]     @default([])
  createdAt           DateTime     @default(now())
  expiresAt           DateTime
  deletedAt           DateTime?
  isArchived          Boolean      @default(false)

  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  views               StatusView[]
  replies             StatusReply[]

  @@index([userId, expiresAt])
  @@map("statuses")
}

// 16. Status Views Model (Unique viewers with timestamps & reactions)
model StatusView {
  id                  String       @id @default(uuid())
  statusId            String
  viewerId            String
  reaction            String?
  viewedAt            DateTime     @default(now())

  status              Status       @relation(fields: [statusId], references: [id], onDelete: Cascade)
  viewer              User         @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([statusId, viewerId])
  @@index([statusId])
  @@map("status_views")
}

// 17. Status Replies Model (Dispatched to private chat)
model StatusReply {
  id                  String       @id @default(uuid())
  statusId            String
  senderId            String
  receiverId          String
  messageId           String?
  messageText         String
  previewMediaUrl     String?
  createdAt           DateTime     @default(now())

  status              Status       @relation(fields: [statusId], references: [id], onDelete: Cascade)
  sender              User         @relation("StatusSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver            User         @relation("StatusReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([statusId])
  @@map("status_replies")
}
