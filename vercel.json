{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/gallery.html", "dest": "/gallery.html" },
    { "src": "/login.html", "dest": "/login.html" },
    { "src": "/engihub_logo.jpg", "dest": "/engihub_logo.jpg" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
